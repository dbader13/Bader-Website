 title = {{CoBLOC}-Continuous Block Level Fairness on Data Streams},
 year = {2026},
 volume = {19},
 number = {12},
 url       = {},
 doi= {10.14778/3827998.3828091},
 abstract = {We present \texttt{CoBLOC}, the first interactive system for enforcing \emph{continuous group fairness} over sliding windows in data streams. \texttt{CoBLOC} introduces \emph{block-level fairness}, a fine-grained fairness model that exposes short-term disparities missed by window-level guarantees, and supports efficient real-time monitoring using compact sketch-based summaries. When violations occur, \texttt{CoBLOC} applies theoretically grounded stream reordering algorithms to restore fairness within the current window, while maintaining low-latency, high-throughput performance suitable for real-world streaming analytics. Through interactive demonstrations, \texttt{CoBLOC} also surfaces serendipitous moments where fairness adjustments become critical, provides intuitive explanations of its decisions, and recommends landmark sizes that best balance reordering cost and fairness in dynamic streaming settings.}
}
